generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  password     String
  role         Role       @default(WAITER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cashFlows    CashFlow[]
  orders       Order[]
  shiftsOpened Shift[]    @relation("ShiftOpenedBy")
  shiftsClosed Shift[]    @relation("ShiftClosedBy")
}

model Category {
  id               String           @id @default(cuid())
  name             String           @unique
  preparationPlace PreparationPlace @default(KITCHEN)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  products         Product[]
}

model Product {
  id                  String      @id @default(cuid())
  name                String
  description         String?
  variants            Json        @default("[]")
  flavors             Json        @default("[]")
  maxFlavors          Int         @default(0)
  canBeHalfAndHalf    Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  categoryId          String
  allowMultipleSauces Boolean     @default(false)
  maxSauces           Int         @default(0)
  requiresSizes       Boolean     @default(false)
  orderItems          OrderItem[]
  category            Category    @relation(fields: [categoryId], references: [id])
}

model Table {
  id        String      @id @default(cuid())
  number    Int
  capacity  Int         @default(4)
  type      TableType   @default(TABLE)
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orders    Order[]

  @@unique([number, type])
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  orderType  OrderType   @default(EAT_IN)
  total      Decimal     @default(0) @db.Decimal(10, 2)
  clientType String?     @default("GENERAL")
  clientName String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tableId    String?
  waiterId   String
  cashFlows  CashFlow[]
  table      Table?      @relation(fields: [tableId], references: [id])
  waiter     User        @relation(fields: [waiterId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id          String          @id @default(cuid())
  quantity    Int
  price       Decimal         @db.Decimal(10, 2)
  notes       String?
  pizzaConfig Json?
  status      OrderItemStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderId     String
  productId   String
  order       Order           @relation(fields: [orderId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
}

model CashFlow {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  type          CashFlowType
  description   String
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  userId        String
  orderId       String?
  shiftId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  shift         Shift?        @relation(fields: [shiftId], references: [id])
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum OrderType {
  EAT_IN
  TAKE_AWAY
  DELIVERY
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableType {
  TABLE
  STOOL
}

enum PreparationPlace {
  KITCHEN
  WAITER_BAR
}

model Shift {
  id              String      @id @default(cuid())
  status          ShiftStatus @default(OPEN)
  openingBalance  Decimal     @db.Decimal(10, 2)
  expectedBalance Decimal?    @db.Decimal(10, 2)
  actualBalance   Decimal?    @db.Decimal(10, 2)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  openedById      String
  closedById      String?

  openedBy        User        @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy        User?       @relation("ShiftClosedBy", fields: [closedById], references: [id])
  cashFlows       CashFlow[]
}

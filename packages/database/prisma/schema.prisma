// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  ADMIN
  WAITER
  KITCHEN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum OrderType {
  EAT_IN
  TAKE_AWAY
  DELIVERY
}

// --- MODELS ---

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      Role     @default(WAITER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  cashFlows CashFlow[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  price               Decimal  @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  requiresSizes       Boolean  @default(false)
  allowMultipleSauces Boolean  @default(false)
  maxSauces           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Table {
  id        String      @id @default(cuid())
  number    Int         @unique
  capacity  Int         @default(4)
  status    TableStatus @default(AVAILABLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders Order[]
}

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  orderType  OrderType   @default(EAT_IN)
  total      Decimal     @default(0) @db.Decimal(10, 2)
  clientType String?     @default("GENERAL") // e.g. "FREQUENT", "NEW"
  clientName String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tableId String?
  table   Table? @relation(fields: [tableId], references: [id])

  waiterId String
  waiter   User   @relation(fields: [waiterId], references: [id])

  items     OrderItem[]
  cashFlows CashFlow[]
}

model OrderItem {
  id          String          @id @default(cuid())
  quantity    Int
  price       Decimal         @db.Decimal(10, 2) // Snapshot at sale time
  notes       String?
  pizzaConfig Json?           // Flexible storage for halves/extras
  status      OrderItemStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model CashFlow {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  type          CashFlowType
  description   String
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
}

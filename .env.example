# ==============================================================================
#                      MR-KING ERP - CONFIGURACIÓN DEL SISTEMA
# ==============================================================================
# Este archivo contiene las configuraciones principales del sistema.
# Puedes editar los valores directamente con el Bloc de Notas.
# Tras modificar cualquier valor, reinicia el sistema para aplicar los cambios.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PINES DE SEGURIDAD (Acceso a Caja y Permisos)
# ------------------------------------------------------------------------------
ADMIN_PIN=1234
WAITER_PIN=0000

# ------------------------------------------------------------------------------
# 2. IMPRESORA DE COCINA (Comandas por Red Ethernet o Wi-Fi)
# ------------------------------------------------------------------------------
# Dirección IP asignada a la impresora de cocina en tu router local:
KITCHEN_PRINTER_IP=192.168.3.201

# Puerto estándar de impresión térmica ESC/POS (generalmente 9100):
KITCHEN_PRINTER_PORT=9100

# ------------------------------------------------------------------------------
# 3. IMPRESORA DE CAJA (Tickets y Recibos USB conectados a la PC Servidor)
# ------------------------------------------------------------------------------
# Nombre de la impresora compartida en Windows (Panel de Control -> Impresoras):
CASH_PRINTER_NAME=Caja_Printer

# Configuración del Micro-Relay de Impresión USB de Windows:
PRINTER_RELAY_HOST=host.docker.internal
PRINTER_RELAY_PORT=9101
